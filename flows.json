    {
        "id": "a2d06794c826e423",
        "type": "function",
        "z": "9f1b08f055ae0336",
        "name": "SHRAMS Desicion Engine",
        "func": "//--------------------------------------------------\n// SHRAMS Comfort Engine V5.1\n//--------------------------------------------------\n\n// Wait until first occupancy message arrives\n\nif(msg.topic !== \"hostel/room1/occupancy\")\n{\n    return null;\n}\n\nlet occupancy = msg.payload;\n\n// Desired outputs\n\nlet desiredLight =\n    (occupancy === \"PRESENT\")\n    ? \"LIGHT_ON\"\n    : \"LIGHT_OFF\";\n\nlet desiredFan =\n    (occupancy === \"PRESENT\")\n    ? \"FAN_ON\"\n    : \"FAN_OFF\";\n\n// Previous outputs\n\nlet lastLight = context.get(\"lastLight\") || \"\";\nlet lastFan   = context.get(\"lastFan\") || \"\";\n\n// Light\n\nif(desiredLight !== lastLight)\n{\n    node.send({\n        topic:\"hostel/room1/control/light\",\n        payload:desiredLight\n    });\n\n    context.set(\"lastLight\", desiredLight);\n}\n\n// Fan\n\nif(desiredFan !== lastFan)\n{\n    node.send({\n        topic:\"hostel/room1/control/fan\",\n        payload:desiredFan\n    });\n\n    context.set(\"lastFan\", desiredFan);\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 160,
