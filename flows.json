    {
        "id": "935207ec8c54bc09",
        "type": "function",
        "z": "9f1b08f055ae0336",
        "name": "Safety Decision Engine",
        "func": "//--------------------------------------------------\n// SHRAMS Safety Engine V5.1\n//--------------------------------------------------\n\nconst GAS_THRESHOLD = 3500;\n\n// Read stored values\n\nlet temperature = context.get(\"temperature\");\nlet gas = context.get(\"gas\");\n\n// Update incoming value\n\nif(msg.topic === \"hostel/room1/temperature\")\n{\n    temperature = Number(msg.payload);\n    context.set(\"temperature\", temperature);\n}\n\nif(msg.topic === \"hostel/room1/gas\")\n{\n    gas = Number(msg.payload);\n    context.set(\"gas\", gas);\n}\n\n// Wait until BOTH values received\n\nif(temperature === undefined || gas === undefined)\n{\n    return null;\n}\n\n// Determine state\n\nlet alarm = \"SAFE\";\n\nif(temperature >= 40 && gas >= GAS_THRESHOLD)\n{\n    alarm = \"FIRE\";\n}\nelse if(temperature >= 40)\n{\n    alarm = \"WARNING_TEMP\";\n}\nelse if(gas >= GAS_THRESHOLD)\n{\n    alarm = \"WARNING_GAS\";\n}\n\n// Publish only on change\n\nlet lastAlarm = context.get(\"lastAlarm\");\n\nif(alarm !== lastAlarm)\n{\n    context.set(\"lastAlarm\", alarm);\n\n    node.warn(\"Temperature = \" + temperature);\n    node.warn(\"Gas = \" + gas);\n    node.warn(\"Safety State = \" + alarm);\n\n    msg.payload = alarm;\n\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 400,
